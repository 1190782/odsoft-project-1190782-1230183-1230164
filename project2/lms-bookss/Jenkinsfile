pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK 21'
    }

    environment {

        //MAVEN_HOME = '/opt/homebrew' // (MacOS)
        MAVEN_HOME = '\\usr\\bin\\mvn' // (Ubuntu)
        // Update PATH to include Maven's bin directory
        PATH = "${env.PATH}:${MAVEN_HOME}"

        GIT_REPO_URL = 'https://github.com/1190782/odsoft-project-1190782-1230183-1230164.git'  // Your Git repository URL
        GIT_BRANCH = 'main'  // Specify the branch to check out

        SERVER_PORT = '2226'
        GITHUB_TOKEN_ID = 'PASSWORD_JENKINS_SECRET'
        IMAGE_NAME = 'lmsbooks'
        IMAGE_TAG = 'latest'
        DOCKERHUB_CREDENTIALS = credentials('1190782-dockerhub')
        ENVIRONMENT = 'dev'
    }

    stages {
        stage('Debug Environment') {
            steps {
                bat 'java --version'
                bat 'mvn --version'
                bat 'dir'
                bat 'docker ps'
            }
        }

        stage('Check Docker') {
            steps {
                bat 'docker --version'
            }
        }

        stage('Checkout') {
            steps {
                // Step to clone the Git repository
                git branch: "${GIT_BRANCH}",
                    url: "${GIT_REPO_URL}"
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('project2\\lms-bookss') {
                    echo 'Installing dependencies...'
                    bat 'mvn dependency:resolve'
                }
            }
        }

        stage('Clean & Build') {
            steps {
                dir('project2\\lms-bookss') {
                    bat 'dir'
                    bat 'mvn clean compile'
                }
                
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('project2\\lms-bookss') {
                    bat 'mvn package'
                    bat 'docker build -t 1190782/lmsbooks:latest .'
                }
            }
        }

        stage('Docker Image Push Repository') {
            steps {
                dir('project2\\lms-bookss') {
                        withCredentials([usernamePassword(credentialsId: '1190782-dockerhub', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                            bat "docker login -u $DOCKER_USERNAME -p $DOCKER_PASSWORD"
                            bat "docker push 1190782/lmsbooks:latest"
                            bat 'docker logout'
                        }
                }
            }
        }

        stage("Send Email for Approval") {
            steps {
                script {
                    echo "Sending email"
                    try {
                        // Send an HTML email notification with instructions for approval
                        emailext attachLog: true,
                                body: """
                                    <html>
                                        <head>
                                            <style>
                                                body {
                                                    font-family: Arial, sans-serif;
                                                    background-color: #f4f4f9;
                                                    margin: 0;
                                                    padding: 20px;
                                                }
                                                h2 {
                                                    color: #333366;
                                                    font-size: 24px;
                                                    margin-bottom: 10px;
                                                }
                                                h3 {
                                                    color: #444444;
                                                    font-size: 20px;
                                                    margin-top: 20px;
                                                }
                                                p {
                                                    color: #555555;
                                                    font-size: 16px;
                                                    line-height: 1.6;
                                                }
                                                ul {
                                                    margin: 20px 0;
                                                    padding-left: 20px;
                                                    list-style-type: disc;
                                                }
                                                li {
                                                    font-size: 16px;
                                                    color: #555555;
                                                }
                                                a {
                                                    color: rgb(255, 255, 255);
                                                    text-decoration: none;
                                                }
                                                a:hover {
                                                    text-decoration: underline;
                                                }
                                                .cta-button {
                                                    display: inline-block;
                                                    padding: 10px 20px;
                                                    margin-top: 20px;
                                                    background: linear-gradient(45deg, #0073e6, #005bb5);
                                                    color: white;
                                                    font-size: 16px;
                                                    text-decoration: none;
                                                    border-radius: 5px;
                                                    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                                                }
                                                .cta-button:hover {
                                                    background: linear-gradient(45deg, #00bfae, #00a68f);
                                                    box-shadow: 0 6px 8px rgba(0, 0, 0, 0.15);
                                                }
                                                .footer-text {
                                                    color: white;
                                                    font-size: 14px;
                                                    background-color: #333366;
                                                    padding: 10px;
                                                    text-align: center;
                                                    border-radius: 5px;
                                                }
                                            </style>
                                        </head>
                                        <body>
                                            <h2>Pipeline Build Completed</h2>
                                            <p>The pipeline has successfully completed the build stage and is now awaiting your approval to proceed.</p>

                                            <h3>Next Steps:</h3>
                                            <ul>
                                                <li>Review the build results.</li>
                                                <li>Approve the next steps to proceed with deployment.</li>
                                            </ul>

                                            <p>After your approval, the pipeline will continue to the deployment stage.</p>

                                            <p><strong>Pipeline URL:</strong> <a style="color: black" href="${BUILD_URL}console">${BUILD_URL}console</a></p>

                                            <p><strong>Instructions:</strong></p>
                                            <ul>
                                                <li>Click the link above to view the build details.</li>
                                                <li>Once you have reviewed the build logs, click the "Proceed" button below to approve.</li>
                                            </ul>

                                            <!-- Button with inline style for the color -->
                                            <a style="color: white" href="${BUILD_URL}input" class="cta-button">Proceed to Approval</a>

                                            <p>If you have any questions or concerns, please contact the team.</p>

                                            <div class="footer-text">
                                                Thank you for reviewing the pipeline.
                                            </div>
                                        </body>
                                    </html>
                                """,
                                subject: "Pipeline Ready for Approval - ${BUILD_NUMBER}",
                                to: 'engreq950@gmail.com',
                                mimeType: 'text/html'  // Ensure the email is sent as HTML
                    } finally {
                        echo "Email sent"
                        // Pause for manual approval
                        input message: "Do you want to continue?", ok: "Approve", parameters: []
                    }
                }
            }
        }

        stage('Deploy Dev') {
            steps {
                 dir('project2\\lms-bookss') {
                    script {
                        echo "Deploying to Dev environment..."
                        bat 'docker-compose -f docker-compose-dev.yml down --remove-orphans'
                        bat 'docker-compose -f docker-compose-dev.yml up -d --force-recreate'
                    }
                 }
            }
        }

        stage('Run Tests Against Container') {
            steps {
                dir('project2\\lms-bookss') {
                    script {
                        bat 'mvn verify -Dtest.container.url=http://localhost:2226'
                    }
                }
            }
        }

        stage('Adjust Service Scaling') {
            steps {
                dir('project2\\lms-bookss') {
                    script {
                        def scalingOptions = input(
                            message: 'Define the scaling preferences for books:',
                            parameters: [
                                choice(
                                    choices: ['Increase Instances', 'Decrease Instances','Ignore'],
                                    description: 'Select whether to add or reduce books instances.',
                                    name: 'actionType'
                                ),
                                string(
                                    defaultValue: '1',
                                    description: 'Target instance count for book1',
                                    name: 'instancesBook1'
                                ),
                                string(
                                    defaultValue: '1',
                                    description: 'Target instance count for book2',
                                    name: 'instancesBook2'
                                )
                            ]
                        )

                        echo "Chosen action: ${scalingOptions.actionType}"
                        echo "Instance configuration: book1=${scalingOptions.instancesBook1}"
                        echo "Instance configuration: book2=${scalingOptions.instancesBook2}"

                        if (scalingOptions.actionType == 'Increase Instances') {
                            echo "Launching additional instances..."
                            bat "docker-compose -f docker-compose-test.yml up --scale book1=${scalingOptions.instancesBook1} --scale book2=${scalingOptions.instancesBook2} -d"
                        } else if (scalingOptions.actionType == 'Decrease Instances') {
                            echo "Reducing instances to minimum..."
                            bat 'docker-compose -f docker-compose-test.yml up --scale book1=0 --scale book2=0 -d'
                        } else if (scalingOptions.actionType == 'Ignore') {
                            echo "Ignoring this stage..."
                        }
                    }
                }
            }
        }

        stage('Test Env Dev') {
            steps {
                script {
                    bat 'docker ps'

                    // Extrair a porta de book1 usando PowerShell embutido no CMD
                    def book1Port = bat(script: """
                        for /f "tokens=2 delims=:" %%A in ('docker ps --filter "name=book1" --format "{{.Ports}}" ^| find "8080"') do @echo %%A
                    """, returnStdout: true).trim()

                    // Extrair a porta de book2 usando PowerShell embutido no CMD
                    def book2Port = bat(script: """
                        for /f "tokens=2 delims=:" %%A in ('docker ps --filter "name=book2" --format "{{.Ports}}" ^| find "8080"') do @echo %%A
                    """, returnStdout: true).trim()

                    // Limpeza adicional da saída, caso necessário
                    book1Port = book1Port.replaceAll("\\s+", "").replaceAll("->.*", "")
                    book2Port = book2Port.replaceAll("\\s+", "").replaceAll("->.*", "")

                    // Log das portas identificadas
                    echo "Book1 is running on port: ${book1Port}"
                    echo "Book2 is running on port: ${book2Port}"

                    // Testar as portas usando curl
                    bat "curl -X GET http://localhost:${book1Port}/health"
                    bat "curl -X GET http://localhost:${book2Port}/health"
                }
            }
        }

        stage('Tests') {
                steps {
                    dir('project2\\lms-bookss') {
                        script {
                            bat 'mvn test'
                        }
                    }
                }
            }

        stage('Jacoco') {
            steps {
                dir('project2\\lms-bookss') {
                    jacoco execPattern: '**/target/jacoco.exec',
                        classPattern: '**/target/classes',
                        sourcePattern: '**/src/main/java',
                        inclusionPattern: '**/*.class'
                }
            }
        }

        stage('Publish JaCoCo Report') {
            steps {
                dir('project2\\lms-bookss') {
                    publishHTML([
                        reportDir: 'target/site/jacoco',
                        reportFiles: 'index.html',
                        reportName: 'JaCoCo Report',
                        keepAll: true,
                        allowMissing: false,
                        alwaysLinkToLastBuild: true
                    ])
                }
            }
        }

        /* stage('Deploy with Docker Compose') {
            steps {
                script {
                    bat """

                        if ! docker ps --filter "name=rabbitmq_in_lms_network" --format '{{.Names}}' | grep -q rabbitmq_in_lms_network; then
                          docker compose -f docker-compose-rabbitmq.yml up -d
                        else
                          echo "RabbitMQ container already running."
                        fi

                        if ! docker ps --filter "name=postgres_in_lms_network" --format '{{.Names}}' | grep -q postgres_in_lms_network; then
                          docker compose -f docker-compose-postgres.yml up -d
                        else
                          echo "Postgres container already running."
                        fi


                        docker compose -f docker-compose.yml up -d --force-recreate

                    """
                }
            }
        } */

        
    }

    post {
        always {
            echo 'Pipeline completed. Cleaning workspace...'
            //cleanWs()
        }
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }

}