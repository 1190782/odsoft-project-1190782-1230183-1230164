pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK 21'
    }

    environment {
        MAVEN_HOME = '\\usr\\bin\\mvn'
        PATH = "${env.PATH}:${MAVEN_HOME}"
        GIT_REPO_URL = 'https://github.com/1190782/odsoft-project-1190782-1230183-1230164.git'
        GIT_BRANCH = 'main'
        SERVER_PORT = '2226'
        IMAGE_NAME = 'lmsusers'
        IMAGE_TAG = 'latest'
    }

    stages {
        stage('Debug Environment') {
            steps {
                bat 'java --version'
                bat 'mvn --version'
                bat 'dir'
                bat 'docker ps'
            }
        }

        stage('Check Docker') {
            steps {
                bat 'docker --version'
            }
        }

        stage('Checkout') {
            steps {
                git branch: "${GIT_BRANCH}",
                    url: "${GIT_REPO_URL}"
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('project2\\lms-bookss') {
                    echo 'Installing dependencies...'
                    bat 'mvn dependency:resolve'
                }
            }
        }

        stage('Build') {
            steps {
                dir('project2\\lms-userss') {
                    bat 'dir'
                    bat 'mvn clean compile'
                }

            }
        }

        stage('Run Tests Against Container') {
            steps {
                dir('project2\\lms-userss') {
                    script {
                        bat 'mvn verify -Dtest.container.url=http://localhost:2226'
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('project2\\lms-userss') {
                    bat 'mvn package'
                    bat 'docker build -t 1190782/lmsusers:latest .'
                }
            }
        }

        stage('Docker Image Push Repository') {
            steps {
                dir('project2\\lms-userss') {
                    bat 'docker login -u 1190782 -p dckr_pat_78I6z_Ldwkw1VgXleBe7Oa6F3f0'
                    bat 'docker push 1190782/lmsusers:latest'
                    bat 'docker logout'
                }
            }
        }

        stage('Adjust Service Scaling') {
            steps {
                dir('project2\\lms-userss') {
                    script {
                        def scalingOptions = input(
                            message: 'Define the scaling preferences for users:',
                            parameters: [
                                choice(
                                    choices: ['Increase Instances', 'Decrease Instances'],
                                    description: 'Select whether to add or reduce users instances.',
                                    name: 'actionType'
                                ),
                                string(
                                    defaultValue: '3',
                                    description: 'Target instance count for users1',
                                    name: 'instancesUsers1'
                                ),
                                string(
                                    defaultValue: '3',
                                    description: 'Target instance count for users2',
                                    name: 'instancesUsers2'
                                )
                            ]
                        )

                        echo "Chosen action: ${scalingOptions.actionType}"
                        echo "Instance configuration: users1=${scalingOptions.instancesUsers1}"
                        echo "Instance configuration: users2=${scalingOptions.instancesUsers2}"

                        bat 'docker-compose -f docker-compose-test.yml down --remove-orphans'

                        if (scalingOptions.actionType == 'Increase Instances') {
                            echo "Launching additional instances..."
                            bat "docker-compose -f docker-compose-test.yml up --scale users1=${scalingOptions.instancesUsers1} --scale users2=${scalingOptions.instancesUsers2} -d"
                        } else if (scalingOptions.actionType == 'Decrease Instances') {
                            echo "Reducing instances to minimum..."
                            bat 'docker-compose -f docker-compose-test.yml up --scale users1=0 --scale users2=0 -d'
                        }
                    }
                }
            }
        }

         stage('Checkstyle') {
            steps {
                dir('project2\\lms-userss') {
                    script {
                        bat 'mvn checkstyle:checkstyle -Dcheckstyle.failOnViolation=false'
                    }
                }
            }
         }

         stage('Publish Checkstyle Report') {
             steps {
                dir('project2\\lms-userss') {
                     publishHTML([
                         reportDir: 'target/site',
                         reportFiles: 'checkstyle.html',
                         reportName: 'Checkstyle Report',
                         keepAll: true,
                         allowMissing: false,
                         alwaysLinkToLastBuild: true
                     ])
                }
             }
         }

         stage('Tests') {
              steps {
                  dir('project2\\lms-userss') {
                      script {
                            bat 'mvn test'
                      }
                  }
              }
         }

         stage('Jacoco') {
             steps {
                 dir('project2\\lms-userss') {
                     jacoco execPattern: '**/target/jacoco.exec',
                            classPattern: '**/target/classes',
                            sourcePattern: '**/src/main/java',
                            inclusionPattern: '**/*.class'
                 }
             }
         }

         stage('Publish JaCoCo Report') {
             steps {
                 dir('project2\\lms-userss') {
                     publishHTML([
                         reportDir: 'target/site/jacoco',
                         reportFiles: 'index.html',
                         reportName: 'JaCoCo Report',
                         keepAll: true,
                         allowMissing: false,
                         alwaysLinkToLastBuild: true
                     ])
                 }
             }
         }

         stage("Send Email for Approval") {
                     steps {
                         script {
                             echo "Sending email"
                             try {
                                 // Send an HTML email notification with instructions for approval
                                 emailext attachLog: true,
                                         body: """
                                             <html>
                                                 <head>
                                                     <style>
                                                         body {
                                                             font-family: Arial, sans-serif;
                                                             background-color: #f4f4f9;
                                                             margin: 0;
                                                             padding: 20px;
                                                         }
                                                         h2 {
                                                             color: #333366;
                                                             font-size: 24px;
                                                             margin-bottom: 10px;
                                                         }
                                                         h3 {
                                                             color: #444444;
                                                             font-size: 20px;
                                                             margin-top: 20px;
                                                         }
                                                         p {
                                                             color: #555555;
                                                             font-size: 16px;
                                                             line-height: 1.6;
                                                         }
                                                         ul {
                                                             margin: 20px 0;
                                                             padding-left: 20px;
                                                             list-style-type: disc;
                                                         }
                                                         li {
                                                             font-size: 16px;
                                                             color: #555555;
                                                         }
                                                         a {
                                                             color: rgb(255, 255, 255);
                                                             text-decoration: none;
                                                         }
                                                         a:hover {
                                                             text-decoration: underline;
                                                         }
                                                         .cta-button {
                                                             display: inline-block;
                                                             padding: 10px 20px;
                                                             margin-top: 20px;
                                                             background: linear-gradient(45deg, #0073e6, #005bb5);
                                                             color: white;
                                                             font-size: 16px;
                                                             text-decoration: none;
                                                             border-radius: 5px;
                                                             box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                                                         }
                                                         .cta-button:hover {
                                                             background: linear-gradient(45deg, #00bfae, #00a68f);
                                                             box-shadow: 0 6px 8px rgba(0, 0, 0, 0.15);
                                                         }
                                                         .footer-text {
                                                             color: white;
                                                             font-size: 14px;
                                                             background-color: #333366;
                                                             padding: 10px;
                                                             text-align: center;
                                                             border-radius: 5px;
                                                         }
                                                     </style>
                                                 </head>
                                                 <body>
                                                     <h2>Pipeline Build Completed</h2>
                                                     <p>The pipeline has successfully completed the build stage and is now awaiting your approval to proceed.</p>

                                                     <h3>Next Steps:</h3>
                                                     <ul>
                                                         <li>Review the build results.</li>
                                                         <li>Approve the next steps to proceed with deployment.</li>
                                                     </ul>

                                                     <p>After your approval, the pipeline will continue to the deployment stage.</p>

                                                     <p><strong>Pipeline URL:</strong> <a style="color: black" href="${BUILD_URL}console">${BUILD_URL}console</a></p>

                                                     <p><strong>Instructions:</strong></p>
                                                     <ul>
                                                         <li>Click the link above to view the build details.</li>
                                                         <li>Once you have reviewed the build logs, click the "Proceed" button below to approve.</li>
                                                     </ul>

                                                     <!-- Button with inline style for the color -->
                                                     <a style="color: white" href="${BUILD_URL}input" class="cta-button">Proceed to Approval</a>

                                                     <p>If you have any questions or concerns, please contact the team.</p>

                                                     <div class="footer-text">
                                                         Thank you for reviewing the pipeline.
                                                     </div>
                                                 </body>
                                             </html>
                                         """,
                                         subject: "Pipeline Ready for Approval - ${BUILD_NUMBER}",
                                         to: 'engreq950@gmail.com',
                                         mimeType: 'text/html'  // Ensure the email is sent as HTML
                             } finally {
                                 echo "Email sent"
                                 // Pause for manual approval
                                 input message: "Do you want to continue?", ok: "Approve", parameters: []
                             }
                         }
                     }
                 }
    }

    post {
        always {
            echo 'Pipeline completed. Cleaning workspace...'
            cleanWs()
        }
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}